# kokedb environment variables. Copy to `.env` and adjust as needed.
# (The Makefile passes PG_META_DSN / KOKEDB_TEST_DSN explicitly; these are the
#  values the server reads directly via std::env if you run it by hand.)

# ── Meta store (PostgreSQL) ─────────────────────────────────────────────────
# Where kokedb keeps its catalog/stats tables. The `kokedb` database is created
# by `make up`; the `system` schema/tables are created by the server on startup.
PG_META_DSN=postgresql://postgres:123456@127.0.0.1:25432/kokedb

# ── Integration tests ───────────────────────────────────────────────────────
# Source DB the #[ignore]d DB-backed tests run against (seeded by `make up`).
KOKEDB_TEST_DSN=postgresql://postgres:123456@127.0.0.1:25432/postgres

# ── Result cache (foyer hybrid: memory + disk) ──────────────────────────────
RESULT_CACHE_DIR=/tmp/kokedb-cache
# zstd compression level for cached Arrow IPC payloads (1-22).
RESULT_CACHE_ZSTD_LEVEL=3

# ── Remote-table sync / caching ─────────────────────────────────────────────
# Rows per batch when reading a remote PostgreSQL table into parquet.
KOKEDB_READ_TABLE_BATCH_SIZE=300000
# Per-table read timeout, seconds.
KOKEDB_READ_TABLE_TIMEOUT=3600
# Background cache-sync schedule interval, minutes.
KOKEDB_CACHE_JOB_INTERVAL=30
# How many parquet snapshot versions to keep per table.
CACHE_KEEP_NUM=3
# Incremental sync: after this many consecutive incremental merges, force a full
# refresh to reconcile source-side hard deletes (timestamp watermarks can't see
# deletes). A table syncs incrementally only when it has a primary key and an
# "updated_at"-style timestamp column; otherwise it falls back to full sync.
KOKEDB_FORCE_FULL_EVERY=10
